{
  "name": "action-surefire-report",
  "version": "1.10.0",
  "description": "",
  "author": "Scalable Capital",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "main": "lib/index.js",
  "homepage": "https://github.com/ScalableCapital/action-surefire-report#readme",
  "scripts": {
    "eslint": "eslint .",
    "build:ts": "tsc -p tsconfig.json",
    "package": "tsc -p tsconfig.json && ncc build lib/index.js -o dist",
    "test": "vitest run",
    "test-ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=junit.xml",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.vitest.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScalableCapital/action-surefire-report"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "Junit",
    "Surefire"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bugs": {
    "url": "https://github.com/ScalableCapital/action-surefire-report/issues"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@actions/glob": "0.7.0",
    "@octokit/plugin-retry": "8.1.0",
    "@octokit/rest": "22.0.1",
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@octokit/fixtures": "23.1.2",
    "@types/node": "25.8.0",
    "@vercel/ncc": "0.38.4",
    "enzyme": "3.11.0",
    "eslint": "10.3.0",
    "globals": "17.6.0",
    "nock": "14.0.15",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
